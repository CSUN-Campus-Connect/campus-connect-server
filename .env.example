# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# JWT Configuration
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d
REFRESH_SECRET=replace-with-strong-random-secret
REFRESH_SECRET_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=11

# Database Configuration (Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration (Frontend URL)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Brevo Email Configuration
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_FROM_NAME=CampusConnect
PASSWORD_RESET_TOKEN_EXPIRY=3600000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_KEY=
FROM_EMAIL=no-reply@csuncampusconnect.com

# SendGrid (alternative email provider — uncomment to use)
#SENDGRID_API_KEY=
#EMAIL_FROM=no-reply@csun.online
#SENDGRID_FROM_NAME=CampusConnect

# Livekit Streaming
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Expo Local Development URL (set to your machine's LAN IP)
EXPO_LOCAL_URL=http://YOUR_LOCAL_IP:8081

# S3 Bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=toro-campusconnect-assets

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ENABLED=false
TWILIO_MAX_MPS=5

# Gemini API
GEMINI_API_KEY=

# Expo Gemini API (exposed to the mobile client — use a separate key)
EXPO_PUBLIC_GEMINI_API_KEY=