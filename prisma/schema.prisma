generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model SundialNews {
  id        String              @id @default(dbgenerated("gen_random_uuid()"))
  category  SundialNewsCategory
  title     String
  date      DateTime
  link      String              @unique
  image     String?
  createdAt DateTime            @default(now())

  @@index([category])
  @@index([createdAt(sort: Desc)])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  source      SourceType?
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  banner      String?
  url         String?  @unique
  clubId      String?
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?     @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([clubId])
  @@index([startDate, endDate])
}

model User {
  id                          String              @id @default(uuid())
  email                       String              @unique
  phoneNumber                 String?
  emergencyAlertsOptIn        Boolean             @default(true)
  expoPushToken               String?
  expoPushTokenUpdatedAt      DateTime?
  firstName                   String
  lastName                    String
  isVerified                  Boolean             @default(false)
  profilePicture              String?
  bio                         String?
  userType                    UserType
  createdAt                   DateTime            @default(now())
  lastActiveAt                DateTime?
  city                        String?
  websites                    String[]            @default([])
  passwordHashed              String
  verificationToken           String?
  verificationTokenExpiration DateTime?
  passwordResetExpiry         DateTime?
  passwordResetToken          String?             @unique
  alumni                      Alumni?
  Comment                     Comment[]
  receivedRequests            ConnectionRequest[] @relation("Received")
  sentRequests                ConnectionRequest[] @relation("Sent")
  event                       Event[]             @relation("CreatedEvents")
  faculty                     Faculty?
  Like                        Like[]
  Livestream                  Livestream[]
  Post                        Post[]
  student                     Student?
  User_A                      User[]              @relation("UserConnections")
  User_B                      User[]              @relation("UserConnections")
  marketplaceListings         MarketplaceListing[] @relation("MarketplaceListings")
  marketplaceFavorites        MarketplaceFavorite[] @relation("UserFavorites")

  ConversationsCreated        Conversation[]            @relation("CreatedConversations")
  ConversationParticipant     ConversationParticipant[]
  Message                     Message[]
  MessageReaction             MessageReaction[]

  preferences      UserPreferences?
  blockedUsers     BlockedUser[]    @relation("BlockerUser")
  blockedBy        BlockedUser[]    @relation("BlockedUser")
  loginHistory     LoginHistory[]
  sessions         UserSession[]
  bugReports       BugReport[]
  bugAssignments   BugReport[]     @relation("BugAssignee")

  clubsCreated     Club[]           @relation("CreatedClubs")
  clubMemberships  ClubMembership[]
  clubJoinRequests ClubJoinRequest[]
  notifications    Notification[]

  roles              UserRole[]
  contentReports     ContentReport[]    @relation("ReportedByUser")
  moderationAssigned ContentReport[]    @relation("AssignedModerator")
  moderationActions  ModerationAction[] @relation("ModeratorActions")
  adminAuditLogs     AdminAuditLog[]
  announcements      Announcement[]     @relation("AnnouncementAuthor")
  securityReports      SecurityReport[]   @relation("SecurityReporter")
  securityAssignments  SecurityReport[]   @relation("SecurityAssignee")
  announcementsEnded       Announcement[]           @relation("AnnouncementsEnded")
  announcementDismissals   AnnouncementDismissal[]
  announcementDeliveries   AnnouncementDelivery[]
}

model Student {
  userId         String    @unique
  studentId      String    @unique
  major          String
  minor          String?
  year           ClassYear
  graduationYear Int
  gpa            Float?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([graduationYear])
}

model Faculty {
  userId            String   @unique
  employeeId        String   @unique
  department        String
  title             String
  officeLocation    String
  researchInterests String?
  sections          String[] @default([])
  officeHours       String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alumni {
  userId          String  @unique
  degree          String
  currentCompany  String?
  industry        String?
  isMentor        Boolean @default(false)
  currentPosition String?
  graduationYear  Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([graduationYear])
}

model ConnectionRequest {
  id         String        @id @default(cuid())
  sendId     String
  receiverId String
  status     RequestStatus @default(pending)
  createdAt  DateTime      @default(now())
  receiver   User          @relation("Received", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User          @relation("Sent", fields: [sendId], references: [id], onDelete: Cascade)

  @@index([sendId])
  @@index([receiverId])
  @@index([status])
}

model Comment {
  id        String   @id
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id
  userId    String
  postId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Livestream {
  id          String       @id
  userId      String
  title       String
  status      StreamStatus @default(LIVE)
  viewerCount Int          @default(0)
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model Post {
  id             String    @id
  userId         String
  content        String
  images         String[]  @default([])
  isRepost       Boolean   @default(false)
  originalPostId String?
  repostComment  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Comment        Comment[]
  Like           Like[]
  Post           Post?     @relation("PostToPost", fields: [originalPostId], references: [id])
  other_Post     Post[]    @relation("PostToPost")
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([originalPostId])
  @@index([userId])
}

model MarketplaceListing {
  id            String                @id @default(cuid())
  title         String
  description   String
  price         Float
  originalPrice Float?
  images        String[]              @default([])
  condition     ItemCondition
  category      MarketplaceCategory
  location      String
  views         Int                   @default(0)
  status        ListingStatus         @default(active)
  sellerId      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  seller        User                  @relation("MarketplaceListings", fields: [sellerId], references: [id], onDelete: Cascade)
  favoritedBy   MarketplaceFavorite[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([sellerId])
  @@index([price])
}

model MarketplaceFavorite {
  id        String             @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime           @default(now())
  user      User               @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Conversation {
  id           String                    @id
  name         String?
  isGroup      Boolean                   @default(false)
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime
  groupPictureUrl String?
  CreatedBy    User                      @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  Participants ConversationParticipant[]
  Messages     Message[]

  @@index([updatedAt(sort: Desc)])
  @@index([createdById])
}

model ConversationParticipant {
  id                String       @id
  conversationId    String
  userId            String
  isAdmin           Boolean      @default(false)
  lastReadMessageId String?
  joinedAt          DateTime     @default(now())
  Conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String            @id
  conversationId String
  senderId       String
  content        String
  isEdited       Boolean           @default(false)
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  Conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  Reactions      MessageReaction[]
  Attachments    MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  type      String
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model UserPreferences {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  theme                      String   @default("light")
  textSize                   String   @default("medium")
  clubsNotifications         Boolean  @default(true)
  campusEventsNotifications  Boolean  @default(true)
  marketplaceNotifications   Boolean  @default(true)
  academicNotifications      Boolean  @default(true)
  followRequestNotifications Boolean  @default(true)
  accountVisibility          String   @default("everyone")
  whoCanMessage              String   @default("everyone")
  allowTagging               Boolean  @default(true)
  pinnedThreadIds            String[] @default([])
  chatBackgrounds            Json?
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  deviceLabel String
  ipAddress   String?
  location    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  deviceLabel  String
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  category    String
  severity    String
  description String
  steps       String?
  browser     String?
  reportStatus BugReportStatus @default(open)
  assignedToId    String?
  assignedTo      User?           @relation("BugAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt(sort: Desc)])
  @@index([severity])
}

model Club {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    ClubCategory
  logo        String?
  isPrivate   Boolean          @default(false)
  status      ClubStatus       @default(pending)
  rejectionReason String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("CreatedClubs", fields: [createdById], references: [id], onDelete: Cascade)
  members     ClubMembership[]
  joinRequests ClubJoinRequest[]
  events      Event[]
  @@index([category])
  @@index([createdById])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole @default(member)
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubJoinRequest {
  id        String         @id @default(cuid())
  clubId    String
  userId    String
  status    ClubJoinStatus @default(pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([status])
}

// Admin Portal & Roles
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
}

model UserRole {
  id              String    @id @default(cuid())
  userId          String
  roleId          String
  departmentScope String?
  grantedById     String?
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, departmentScope])
  @@index([userId])
  @@index([roleId])
}

model ContentReport {
  id           String              @id @default(cuid())
  reporterId   String
  targetType   ContentTargetType
  targetId     String
  reason       ContentReportReason
  description  String?
  status       ModerationStatus    @default(PENDING)
  priority     ModerationPriority  @default(NORMAL)
  assignedToId String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  reporter   User  @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedModerator", fields: [assignedToId], references: [id], onDelete: SetNull)

  actions ModerationAction[]

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([createdAt(sort: Desc)])
}

model ModerationAction {
  id          String               @id @default(cuid())
  reportId    String
  moderatorId String
  action      ModerationActionType
  note        String?
  createdAt   DateTime             @default(now())

  report    ContentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderator User          @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([moderatorId])
}

model UserViolation {
  id         String        @id @default(cuid())
  userId     String
  type       ViolationType
  reason     String
  reportId   String?
  issuedById String
  expiresAt  DateTime?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([isActive])
  @@index([createdAt(sort: Desc)])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  type      AnnouncementType   @default(INFO)
  isActive  Boolean            @default(true)
  audience  AnnouncementTarget @default(ALL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  authorId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // New fields - critical alert system
  severity             AnnouncementSeverity?
  channels             AnnouncementChannel[]   @default([])
  location             String?
  testMode             Boolean                 @default(false)

  // Severity chain (RED -> BLUE -> GREEN links)
  parentAnnouncementId String?
  parentAnnouncement   Announcement?           @relation("AnnouncementChain", fields: [parentAnnouncementId], references: [id])
  childAnnouncements   Announcement[]          @relation("AnnouncementChain")

  // Banner broadcast receipt
  bannerBroadcastAt    DateTime?

  // GREEN auto-expire
  expiresAt            DateTime?

  // End metadata
  endedAt              DateTime?
  endedById            String?
  endReason            String?
  endedBy              User?                   @relation("AnnouncementsEnded", fields: [endedById], references: [id], onDelete: SetNull)

  // Fast dashboard counters
  deliveryCounts       Json?

  // Author (existing relation, unchanged)
  author               User                    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Delivery rows + dismissals
  deliveries           AnnouncementDelivery[]
  dismissals           AnnouncementDismissal[]

  @@index([isActive, startsAt])
  @@index([severity, isActive])
  @@index([parentAnnouncementId])
  @@index([createdAt(sort: Desc)])
}

model AnnouncementDelivery {
  id                 String                     @id @default(cuid())
  announcementId     String
  userId             String
  channel            AnnouncementChannel
  status             AnnouncementDeliveryStatus @default(PENDING)

  attempts           Int                        @default(0)
  nextRetryAt        DateTime                   @default(now())
  lastAttemptAt      DateTime?

  providerMessageId  String?
  providerReceiptId  String?
  failReason         String?

  fellBackToChannel  AnnouncementChannel?

  queuedAt           DateTime                   @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  finalizedAt        DateTime?

  announcement       Announcement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, channel])
  @@index([status, nextRetryAt])
  @@index([announcementId, channel, status])
  @@index([providerMessageId])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SecurityReport {
  id                    String                @id @default(cuid())
  caseNumber            String                @unique
  reporterId            String?
  reportType            SecurityReportType
  urgency               SecurityUrgency
  status                SecurityStatus        @default(SUBMITTED)
  title                 String
  description           String
  location              String?
  latitude              Float?
  longitude             Float?
  incidentDate          DateTime
  isAnonymous           Boolean               @default(false)
  anonymousToken        String?               @unique
  assignedDepartment    SecurityDepartment
  assignedToId          String?
  parentReportId        String?
  reporterRelationship  ReporterRelationship  @default(VICTIM)
  cleryGeography        CleryGeography?
  resolvedAt            DateTime?
  resolutionSummary     String?
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reporter        User?              @relation("SecurityReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo      User?              @relation("SecurityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parentReport    SecurityReport?    @relation("LinkedReports", fields: [parentReportId], references: [id])
  childReports    SecurityReport[]   @relation("LinkedReports")
  evidence        ReportEvidence[]
  statusHistory   ReportStatusHistory[]
  messages        ReportMessage[]
  involvedParties ReportInvolvedParty[]

  @@index([status])
  @@index([assignedDepartment])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([urgency])
  @@index([createdAt(sort: Desc)])
  @@index([caseNumber])
}

model ReportEvidence {
  id             String   @id @default(cuid())
  reportId       String
  uploadedById   String
  fileUrl        String
  fileName       String
  fileType       String
  fileSizeBytes  Int
  description    String?
  isRedacted     Boolean  @default(false)
  checksumSha256 String
  uploadedAt     DateTime @default(now())

  report     SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportStatusHistory {
  id             String   @id @default(cuid())
  reportId       String
  previousStatus String
  newStatus      String
  changedById    String
  note           String?
  createdAt      DateTime @default(now())

  report    SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt(sort: Desc)])
}

model ReportMessage {
  id         String   @id @default(cuid())
  reportId   String
  senderId   String
  senderRole SecurityMessageRole
  content    String
  isInternal Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  report SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model ReportInvolvedParty {
  id              String  @id @default(cuid())
  reportId        String
  name            String?
  description     String?
  affiliation     String?
  relationToReporter String?

  report SecurityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

enum UserType {
  student
  faculty
  alumni
}

enum ClassYear {
  freshman
  sophomore
  junior
  senior
}

enum RequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum StreamStatus {
  LIVE
  ENDED
}

enum MarketplaceCategory {
  textbooks
  electronics
  furniture
  clothing
  accessories
  other
}

enum ItemCondition {
  likeNew
  excellent
  good
  fair
  poor
}

enum ListingStatus {
  active
  sold
  inactive
  deleted
}

enum SourceType {
  src
  usu
  general
}

enum NotificationType {
  connectionRequest
  connectionAccepted
  postLike
  postComment
  mention
  clubInvite
  clubJoinRequest
  clubJoinApproved
  clubAnnouncement
  clubEventPosted
  marketplaceUpdate
  followRequest
  eventReminder
  contentReportUpdate
  accountSuspended
  accountWarning
  systemAnnouncement
  roleAssigned
  roleRevoked
}

enum ClubRole {
  president
  vicePresident
  secretary
  treasurer
